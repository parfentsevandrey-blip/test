<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. The whole app is drawn with Jetpack Compose /
         Material 3, so this only needs edge-to-edge, transparent system bars. -->
    <style name="Theme.LuminaCalendar" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
