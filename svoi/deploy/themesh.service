# systemd unit for a headless device (home server, NAS).
#
#   sudo useradd --system --home-dir /var/lib/themesh --no-create-home --shell /usr/sbin/nologin themesh
#       (the home directory is where received files go by default: ~/Downloads/The Mesh)
#   sudo install -m755 themesh /usr/local/bin/themesh
#   sudo install -m644 deploy/themesh.service /etc/systemd/system/themesh.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now themesh
#   sudo -u themesh themesh url --dir /var/lib/themesh    # a one-time address of the web interface (valid 10 minutes);
#       it needs the token, so run it as that user. The journal does not carry the address: a service
#       has no terminal, and a log would keep a link nobody used up (`themesh up --print-link` overrides).
#
# The web interface listens on 127.0.0.1:8777 only; manage this device from
# another member's interface ("Manage device"), or through an SSH tunnel.
[Unit]
Description=themesh — private mesh network of your own devices
Documentation=https://github.com/parfentsevandrey-blip/test
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Create the mesh or join one the first time (before the first start):
#   sudo install -d -o themesh -g themesh -m 700 /var/lib/themesh
#   sudo -u themesh themesh join MESH1-… --dir /var/lib/themesh   (or: init --mesh "Home" --name nas --dir /var/lib/themesh)
ExecStart=/usr/local/bin/themesh up --no-browser --ui 127.0.0.1:8777 --dir /var/lib/themesh
Restart=always
RestartSec=3
User=themesh
Group=themesh
StateDirectory=themesh
StateDirectoryMode=0700

# Hardening. Folders you want to share must be readable (and, for read-write
# shares, writable) — add them to ReadWritePaths= / ReadOnlyPaths=.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
# ReadWritePaths=/srv/share /var/lib/themesh
# ReadOnlyPaths=/srv/media

# For Internet mail (settings → "Own address"): the mail server of the gateway takes the port 25, which an
# ordinary user may not. Give the service only that right, in addition to what is above:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# (or leave the unit as it is, set "Where to listen" in the setup to :2525 and let the router, or
#  `iptables -t nat -A PREROUTING -p tcp --dport 25 -j REDIRECT --to-ports 2525`, forward the port 25 to it.)
# The gateway needs a public address with an open port 25 and records in the DNS of the domain: README, «Своя почта в интернете».

# For the optional virtual network interface (settings → "Network interface",
# `themesh up --tun`) the unit needs these two lines instead of User=themesh:
#   AmbientCapabilities=CAP_NET_ADMIN
#   DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
