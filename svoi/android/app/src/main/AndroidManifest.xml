<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Узел (программа themesh) слушает 127.0.0.1 и сам ходит в сеть: UDP к другим устройствам. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Не терять многоадресные пакеты Wi-Fi (поиск устройств в домашней сети), пока работает узел. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Служба переднего плана, которая держит узел запущенным. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Просьба не ограничивать приложение экономией батареи: без этого телефон «пропадает» из сети.
         Показывается в меню («Работать в фоне без ограничений батареи»), только по желанию человека. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!-- Сохранение скачанного и копий полученных файлов в «Загрузки» на Android 8–9 (с Android 10 хватает MediaStore).
         Из службы в фоне это разрешение не спросить: копии делаются, только если оно уже выдано (меню, «Сохранять
         полученные файлы в «Загрузки»»). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Камера — только чтобы прочитать QR-код приглашения («Сканировать QR-код» в форме «Подключиться по приглашению»).
         Спрашивается при первом открытии сканера; кадры не сохраняются и никуда не передаются. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Камеры может не быть: тогда приложение всё равно ставится и работает, только без кнопки «Сканировать QR-код»
         (код приглашения можно вставить текстом). Поэтому камера и автофокус не обязательны. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- android:extractNativeLibs="true" здесь нет намеренно: AGP сам кладёт его в итоговый манифест из
         packaging { jniLibs { useLegacyPackaging = true } } (app/build.gradle) и не любит, когда оно записано
         ещё и в исходном. libthemesh.so — исполняемый файл, а не библиотека: он обязан быть распакован при установке
         в ApplicationInfo.nativeLibraryDir, откуда его запускает NodeService. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheMesh"
        tools:ignore="DataExtractionRules,UnusedAttribute">

        <!-- Проверка адресов в WebView через Google не нужна: он видит только 127.0.0.1. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.TheMesh.Main"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout|keyboard|navigation|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout|keyboard|navigation|density"
            android:exported="false"
            android:label="@string/log_title" />

        <!-- Сканер QR-кода приглашения: открывается из окна по просьбе страницы (ScanBridge), возвращает приглашение окну. -->
        <activity
            android:name=".ScanActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout|keyboard|navigation|density"
            android:exported="false"
            android:label="@string/scan_title"
            android:theme="@style/Theme.TheMesh.Scan" />

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keeps the private-network node running" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
