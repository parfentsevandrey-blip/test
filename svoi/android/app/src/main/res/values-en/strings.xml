    <string name="about_title">About The Mesh</string>
    <string name="about_text">The Mesh %1$s\nCore: %2$s\nWebView: %3$s\n\nA private network of your own devices: files, mail and chat directly, with no cloud and no account.\nThis is a working prototype without an independent security audit.</string>
