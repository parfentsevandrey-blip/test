    </path>
    <!-- свет, собравшийся внизу бусины -->
    <group
        android:pivotX="54"
        android:pivotY="71"
        android:scaleY="0.47">
        <path android:pathData="M35,71a19,19 0 1,0 38,0a19,19 0 1,0 -38,0z">
