<?xml version="1.0" encoding="utf-8"?>
<!-- Передний план адаптивного значка: стеклянная бусина с меткой The Mesh (три круга, соединённые треугольником, как в
     internal/web/ui/icons/icon.svg), блики на стекле и искра — так выглядят стеклянные карточки «Росы». Холст 108dp, всё
     важное — в безопасной зоне (круг 66dp в центре). -->
