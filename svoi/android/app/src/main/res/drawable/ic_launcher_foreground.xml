    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- тень под бусиной -->
    <group
        android:pivotX="54"
        android:pivotY="81"
        android:scaleY="0.2">
        <path android:pathData="M32,81a22,22 0 1,0 44,0a22,22 0 1,0 -44,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="81"
                    android:gradientRadius="22">
                    <item android:color="#8C150C40" android:offset="0" />
                    <item android:color="#00150C40" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <!-- тело стекла -->
    <path android:pathData="M27,52a27,27 0 1,0 54,0a27,27 0 1,0 -54,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="25"
                android:endX="54"
                android:endY="79">
                <item android:color="#9EFFE9F2" android:offset="0" />
                <item android:color="#5CB9A4FF" android:offset="0.5" />
                <item android:color="#757C69E0" android:offset="1" />
