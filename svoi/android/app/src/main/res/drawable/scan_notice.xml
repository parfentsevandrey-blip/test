<?xml version="1.0" encoding="utf-8"?>
<!-- «Это QR-код не от The Mesh»: плашка цвета ошибки поверх камеры, с тем же светлым ободком, что у стеклянных плашек. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scan_notice" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
