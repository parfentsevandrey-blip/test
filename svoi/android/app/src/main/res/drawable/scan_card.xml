<?xml version="1.0" encoding="utf-8"?>
<!-- Подсказка под рамкой: стеклянная плашка — тёмная полупрозрачная заливка, мягкий блик и светлый ободок;
     заливка достаточно плотная, чтобы белый текст читался на любом кадре. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scan_card" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#00FFFFFF"
                android:startColor="#2EFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
