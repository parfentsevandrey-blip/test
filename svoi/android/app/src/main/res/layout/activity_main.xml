<?xml version="1.0" encoding="utf-8"?>
<!-- Окно: веб-интерфейс узла на весь экран (у страницы своя верхняя полоса, меню приложения открывает её кнопка «⋮»).
     Пока узел не готов, поверх лежит заставка или страница ошибки, и тогда видна узкая верхняя полоса (название,
     состояние сети, меню). Фон окна («северное сияние», при стеклянном виде) и отступы под системные панели
     (edge-to-edge) задаёт MainActivity на корневом элементе; WebView прозрачен, и сияние видно сквозь страницу. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/bar_logo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />

        <TextView
            android:id="@+id/bar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bar_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/status_starting"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/bar_menu"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_more"
            android:scaleType="center"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/splash_orb"
                android:layout_width="104dp"
                android:layout_height="104dp">

                <ImageView
                    android:id="@+id/splash_logo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mark" />
            </FrameLayout>

            <TextView
                android:id="@+id/splash_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/splash_starting"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/error_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/error_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/error_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_title"
                    android:textColor="@color/fg"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/err"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/error_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/error_hint"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/error_restart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="52dp"
                    android:stateListAnimator="@null"
                    android:text="@string/error_restart"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent" />

                <Button
                    android:id="@+id/error_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="52dp"
                    android:stateListAnimator="@null"
                    android:text="@string/error_show_log"
                    android:textAllCaps="false" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
