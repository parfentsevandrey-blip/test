<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Светлая тема (день). Тёмная — в values-night/themes.xml. Без AppCompat: платформенные темы. -->
    <style name="Theme.TheMesh" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Экран сканера: чёрный фон окна, пока не заработала камера (а не бежевый, как у остальных окон). Родитель — Theme.TheMesh
         из values или values-night, смотря какая тема на экране; цвета сканера в обеих одинаковые. -->
    <style name="Theme.TheMesh.Scan" parent="Theme.TheMesh">
        <item name="android:windowBackground">@color/scan_bg</item>
        <item name="android:colorBackground">@color/scan_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
