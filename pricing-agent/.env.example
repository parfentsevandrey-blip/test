# Telegram
TELEGRAM_BOT_TOKEN=            # у @BotFather

# Объяснение вердикта (необязательно — без ключа используется шаблон)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Циан API — доступ по заявке на import@cian.ru.
# Пути методов подставляются из документации, которая приходит вместе с ключом.
CIAN_API_KEY=
CIAN_API_BASE=https://api.cian.ru
CIAN_VALUATION_PATH=
CIAN_OFFERS_PATH=

# 1 — подмешивать синтетические данные о спросе (демо-режим), 0 — только реальные
DEMO_OPS=1
