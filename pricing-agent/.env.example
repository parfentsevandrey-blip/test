# Telegram
TELEGRAM_BOT_TOKEN=            # у @BotFather

# Объяснение вердикта (необязательно — без ключа используется шаблон)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Яндекс Недвижимость ---------------------------------------------------------

# Выгрузка звонков из кабинета юрлица: кнопка «скачать» в правом верхнем углу
# раздела статистики. Поддерживаются .xlsx и .csv. Спрос по лоту связывается
# с реестром по колонке «ID из XML-фида» — это internal-id из нашего же фида.
YANDEX_CALLS_EXPORT=

# Куда складывать собранный YRL-фид (python -m agent.cli --feed)
YANDEX_FEED_PATH=data/yandex-feed.xml

# Оценка квартиры как контрольная точка для коридора.
# Публичного API у калькулятора нет — адрес метода приходит по договорённости
# с площадкой. Пока пусто, коридор считается без сверки.
YANDEX_VALUATION_URL=

# --- Расширение «Циан → Excel» ---------------------------------------------------

# Папка с выгрузками расширения (.xlsx, по одной на ЖК). Это единственный источник
# ЧУЖИХ лотов: ни партнёрское API Циан, ни Яндекс их не отдают.
CIAN_EXPORTS_DIR=data/cian_exports

# 1 — учитывать лоты застройщика в КОРИДОРЕ внутри дома. По умолчанию 0: первичка и
# вторичка — разные рынки, и прайс застройщика смещает оценку наших перепродаж.
# Флаг влияет только на коридор. Независимо от него прайс застройщика всё равно
# используется там, где он незаменим: по нему меряется надбавка за этаж (все условия
# равны, кроме этажа), и он полностью учитывается в анализе локации — иначе из
# выборки исчезает целый конкурирующий проект.
CIAN_INCLUDE_DEVELOPER=0

# 1 — подмешивать синтетические данные о спросе (демо-режим), 0 — только реальные
DEMO_OPS=1
