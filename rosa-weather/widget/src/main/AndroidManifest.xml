<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only when the calendar widget is set to show events, and only after you allow it. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- A tap on a day or on + opens the phone's calendar app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <application>
        <receiver
            android:name=".provider.GlassWidgetProvider"
            android:exported="false"
            android:label="@string/widget_glass_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_glass" />
        </receiver>

        <receiver
            android:name=".provider.SkyWidgetProvider"
            android:exported="false"
            android:label="@string/widget_sky_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_sky" />
        </receiver>

        <receiver
            android:name=".provider.AlmanacWidgetProvider"
            android:exported="false"
            android:label="@string/widget_almanac_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_almanac" />
        </receiver>

        <receiver
            android:name=".provider.CalendarWidgetProvider"
            android:exported="false"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_calendar" />
        </receiver>

        <receiver
            android:name=".provider.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".studio.WidgetStudioActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Rosa.Studio">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
