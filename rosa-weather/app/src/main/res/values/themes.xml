<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rosa" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rosa_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <style name="Theme.Rosa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rosa_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_drop</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Rosa</item>
    </style>
</resources>
