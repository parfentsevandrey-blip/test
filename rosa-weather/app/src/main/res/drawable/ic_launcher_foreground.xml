<?xml version="1.0" encoding="utf-8"?>
<!--
    A dewdrop of liquid glass: the name of the app and the heart of its visual language.
    Like a real drop it works as a lens, so the dusk behind it shows upside down: warm at the
    top, deep blue at the foot, where the light it gathers pools in a bright caustic.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- The glow the drop gathers around itself. -->
    <path android:pathData="M54,57m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="57" android:gradientRadius="32">
                <item android:offset="0" android:color="#47FFDDEB" />
                <item android:offset="0.55" android:color="#14FFDDEB" />
                <item android:offset="1" android:color="#00FFDDEB" />
            </gradient>
        </aapt:attr>
    </path>

    <group android:pivotX="54" android:pivotY="56" android:scaleX="1.08" android:scaleY="1.08">

        <!-- Its shadow on the glass, with the light it focuses landing inside it. -->
        <group android:pivotX="55" android:pivotY="78.5" android:scaleY="0.2">
            <path android:pathData="M55,78.5m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="radial" android:centerX="55" android:centerY="78.5" android:gradientRadius="18">
                        <item android:offset="0" android:color="#66140B30" />
                        <item android:offset="1" android:color="#00140B30" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:pathData="M57,78.5m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="radial" android:centerX="57" android:centerY="78.5" android:gradientRadius="8">
                        <item android:offset="0" android:color="#B3FFD9B8" />
                        <item android:offset="1" android:color="#00FFD9B8" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- The body: the sky behind, refracted upside down. -->
        <path android:pathData="M54,31C54,31 38,50 38,61a16,16 0,0 0,32 0C70,50 54,31 54,31z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="54" android:startY="31" android:endX="54" android:endY="77">
                    <item android:offset="0" android:color="#F5FFE6D9" />
                    <item android:offset="0.3" android:color="#E6F4BCC8" />
                    <item android:offset="0.62" android:color="#D9907ECB" />
                    <item android:offset="1" android:color="#F2403A8C" />
                </gradient>
            </aapt:attr>
        </path>

        <group>
            <clip-path android:pathData="M54,31C54,31 38,50 38,61a16,16 0,0 0,32 0C70,50 54,31 54,31z" />

            <!-- Denser glass towards the edge gives it volume. -->
            <path android:strokeWidth="4" android:strokeColor="#2B201848"
                android:pathData="M54,31C54,31 38,50 38,61a16,16 0,0 0,32 0C70,50 54,31 54,31z" />

            <!-- The caustic: light focused through the drop, pooling at its foot. -->
            <group android:pivotX="55.5" android:pivotY="69.5" android:scaleY="0.58">
                <path android:pathData="M55.5,69.5m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="radial" android:centerX="55.5" android:centerY="69.5" android:gradientRadius="12">
                            <item android:offset="0" android:color="#F2FFF0DE" />
                            <item android:offset="0.45" android:color="#8CFFD3BE" />
                            <item android:offset="1" android:color="#00FFC2B0" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>

            <!-- A faint band of colour where the glass splits the light. -->
            <path android:strokeWidth="1.2" android:strokeLineCap="round"
                android:pathData="M41.2,63.5a13.2,13.2 0,0 0,7.6 10.1">
                <aapt:attr name="android:strokeColor">
                    <gradient android:type="linear" android:startX="41" android:startY="63" android:endX="49" android:endY="74">
                        <item android:offset="0" android:color="#0080E8FF" />
                        <item android:offset="0.5" android:color="#9980E8FF" />
                        <item android:offset="1" android:color="#00FF9FD6" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- The rim: bright where the light comes from, warm again at the foot. -->
        <path android:strokeWidth="1.3"
            android:pathData="M54,31C54,31 38,50 38,61a16,16 0,0 0,32 0C70,50 54,31 54,31z">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="40" android:startY="36" android:endX="68" android:endY="76">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="0.35" android:color="#99FFFFFF" />
                    <item android:offset="0.58" android:color="#26FFFFFF" />
                    <item android:offset="0.82" android:color="#66FFE3D0" />
                    <item android:offset="1" android:color="#E6FFE9DA" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Speculars: the long window reflection, a sharp point, and light bouncing back below. -->
        <path android:pathData="M45.5,58.5c0.6,-4.6 3.4,-9.2 5.6,-12.2c0.4,-0.5 1.1,0 0.8,0.6c-1.8,3.4 -3.6,7.6 -4.1,11.9c-0.1,0.8 -2.4,0.9 -2.3,-0.3z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="51" android:startY="46" android:endX="46" android:endY="59">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="1" android:color="#40FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:fillColor="#F2FFFFFF"
            android:pathData="M46.6,62.6m-1.15,0a1.15,1.15 0,1 1,2.3 0a1.15,1.15 0,1 1,-2.3 0" />
        <path android:strokeColor="#8CFFFFFF" android:strokeWidth="1.3" android:strokeLineCap="round"
            android:pathData="M65.3,65.2a11.6,11.6 0,0 1,-6.2 8.6" />
    </group>

    <!-- A glint of the star the drop was named after. -->
    <path android:pathData="M74,38m-6.5,0a6.5,6.5 0,1 1,13 0a6.5,6.5 0,1 1,-13 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="74" android:centerY="38" android:gradientRadius="6.5">
                <item android:offset="0" android:color="#73FFF1D9" />
                <item android:offset="1" android:color="#00FFF1D9" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#FFFFF6E3"
        android:pathData="M74,33.2c0,0 0.7,4.1 4.8,4.8c-4.1,0.7 -4.8,4.8 -4.8,4.8c0,0 -0.7,-4.1 -4.8,-4.8c4.1,-0.7 4.8,-4.8 4.8,-4.8z" />
    <path android:fillColor="#B3FFFFFF"
        android:pathData="M80.6,45.4m-0.7,0a0.7,0.7 0,1 1,1.4 0a0.7,0.7 0,1 1,-1.4 0" />
</vector>
