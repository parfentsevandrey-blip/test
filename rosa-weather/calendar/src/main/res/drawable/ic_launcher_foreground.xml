        </aapt:attr>
    </path>
    <path android:fillColor="#E6FFFFFF" android:pathData="M56.8,62.4m-0.9,0a0.9,0.9 0,1 1,1.8 0a0.9,0.9 0,1 1,-1.8 0" />

