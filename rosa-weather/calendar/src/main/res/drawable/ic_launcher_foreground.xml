                <item android:offset="1" android:color="#F2F7B48C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Its lit rim. -->
    <path android:strokeWidth="1.4"
        android:pathData="M40,36h28a8,8 0,0 1,8 8v26a8,8 0,0 1,-8 8h-28a8,8 0,0 1,-8 -8v-26a8,8 0,0 1,8 -8z">
