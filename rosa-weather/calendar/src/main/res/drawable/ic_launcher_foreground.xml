<?xml version="1.0" encoding="utf-8"?>
<!--
    Rosa's calendar: a page of liquid glass hanging on two rings, its month strip warm with the
    dusk behind it, the days as small beads — and today a dewdrop, the drop of Rosa Weather.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
