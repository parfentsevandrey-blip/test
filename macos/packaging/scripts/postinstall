#!/bin/sh
# Runs as root when the installer has laid the files down.
#
# Files an installer writes carry no quarantine flag, which is the whole
# reason the app ships as a package: an ad-hoc signed app that *is*
# quarantined is refused by Gatekeeper as "damaged", with no way past it but
# a Terminal command. This clears the flag once more anyway, in case some path
# put it back, and makes sure nothing inside the bundle is left unreadable.
app="/Applications/Veil.app"
if [ -d "$app" ]; then
    /usr/bin/xattr -cr "$app" 2>/dev/null || true
    /bin/chmod -R a+rX "$app" 2>/dev/null || true
fi
exit 0
