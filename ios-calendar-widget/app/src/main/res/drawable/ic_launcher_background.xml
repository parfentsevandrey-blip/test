<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: a brand indigo -> violet diagonal field with a soft
  upper-left bloom. Full 108x108 bleed. Palette-aligned with the default INDIGO
  accent (#4A52CC family) so icon and widget share one language.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:startX="14" android:startY="6"
                android:endX="98" android:endY="104"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF5860E0" />
                <item android:offset="0.52" android:color="#FF454CCB" />
                <item android:offset="1.0" android:color="#FF2E2F8F" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:centerX="30" android:centerY="24"
                android:gradientRadius="92"
                android:type="radial">
                <item android:offset="0.0" android:color="#42FFFFFF" />
                <item android:offset="0.45" android:color="#16FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>