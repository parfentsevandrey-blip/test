<?xml version="1.0" encoding="utf-8"?>
<!-- Baseline (API 26-30) light surface gradient. Corners baked in so the card
     reads as rounded even where GlanceModifier.cornerRadius is a no-op (<31). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient android:type="linear" android:angle="270"
        android:startColor="#FFE7E3EE" android:centerColor="#FFF4F1F8" android:endColor="#FFFCF8FB" />
</shape>
