+/*
+ * Opal: fast UDP rejection.
+ *
+ * Tor carries TCP only, so UDP other than DNS (answered by the mapped DNS
+ * resolver) can never be delivered. Instead of silently dropping it (apps
+ * would wait for a timeout, e.g. QUIC before falling back to TCP), answer
+ * with ICMP/ICMPv6 port unreachable. The error is sourced from the original
+ * destination so the kernel accepts it and fails the socket immediately
+ * with ECONNREFUSED.
+ */
+#define OPAL_ICMP_QUOTE_LEN 8
+
+static void
+opal_icmp4_port_unreach (struct pbuf *p, struct netif *inp)
+{
+    const struct ip_hdr *iphdr;
+    struct icmp_echo_hdr *icmphdr;
+    ip4_addr_t src, dst;
+    struct pbuf *q;
+    u16_t quote;
+
+    if (p->len < IP_HLEN)
+        return;
+
+    iphdr = (const struct ip_hdr *)p->payload;
+    quote = IPH_HL_BYTES (iphdr) + OPAL_ICMP_QUOTE_LEN;
+    if (quote > p->tot_len)
+        quote = p->tot_len;
+
+    q = pbuf_alloc (PBUF_IP, sizeof (struct icmp_echo_hdr) + quote, PBUF_RAM);
+    if (!q)
+        return;
+
+    icmphdr = (struct icmp_echo_hdr *)q->payload;
+    icmphdr->type = ICMP_DUR;
+    icmphdr->code = ICMP_DUR_PORT;
+    icmphdr->id = 0;
+    icmphdr->seqno = 0;
+    pbuf_copy_partial (p, (u8_t *)q->payload + sizeof (struct icmp_echo_hdr),
+                       quote, 0);
+    icmphdr->chksum = 0;
+    icmphdr->chksum = inet_chksum (q->payload, q->len);
+
+    ip4_addr_copy (src, iphdr->dest);
+    ip4_addr_copy (dst, iphdr->src);
+    ip4_output_if (q, &src, &dst, ICMP_TTL, 0, IP_PROTO_ICMP, inp);
+    pbuf_free (q);
+}
+
+static void
+opal_icmp6_port_unreach (struct pbuf *p, struct netif *inp)
+{
+    const struct ip6_hdr *ip6hdr;
+    struct icmp6_hdr *icmp6hdr;
+    ip6_addr_t src, dst;
+    struct pbuf *q;
+    u16_t quote;
+
+    if (p->len < IP6_HLEN)
+        return;
+
+    ip6hdr = (const struct ip6_hdr *)p->payload;
+    quote = IP6_HLEN + OPAL_ICMP_QUOTE_LEN;
+    if (quote > p->tot_len)
+        quote = p->tot_len;
+
+    q = pbuf_alloc (PBUF_IP, sizeof (struct icmp6_hdr) + quote, PBUF_RAM);
+    if (!q)
+        return;
+
+    icmp6hdr = (struct icmp6_hdr *)q->payload;
+    icmp6hdr->type = ICMP6_TYPE_DUR;
+    icmp6hdr->code = ICMP6_DUR_PORT;
+    icmp6hdr->data = 0;
+    pbuf_copy_partial (p, (u8_t *)q->payload + sizeof (struct icmp6_hdr),
+                       quote, 0);
+
+    ip6_addr_copy_from_packed (src, ip6hdr->dest);
+    ip6_addr_copy_from_packed (dst, ip6hdr->src);
+    ip6_addr_clear_zone (&src);
+    ip6_addr_clear_zone (&dst);
+
+    icmp6hdr->chksum = 0;
+    icmp6hdr->chksum =
+        ip6_chksum_pseudo (q, IP6_NEXTH_ICMP6, q->tot_len, &src, &dst);
+    ip6_output_if (q, &src, &dst, 255, 0, IP6_NEXTH_ICMP6, inp);
+    pbuf_free (q);
+}
+
+static void
+udp_reject_handler (void *arg, struct udp_pcb *pcb, struct pbuf *p,
+                    const ip_addr_t *addr, u16_t port)
+{
+    struct netif *inp = ip_current_input_netif ();
+
+    /* Move the payload pointer back to the IP header of the datagram. */
+    if (inp && !pbuf_header_force (p, (s16_t)(ip_current_header_tot_len () +
+                                              UDP_HLEN))) {
+        if (ip_current_is_v6 ())
+            opal_icmp6_port_unreach (p, inp);
+        else
+            opal_icmp4_port_unreach (p, inp);
+    }
+
+    pbuf_free (p);
+    udp_recv (pcb, NULL, NULL);
+    udp_remove (pcb);
+}
+
 static void
 udp_recv_handler (void *arg, struct udp_pcb *pcb, struct pbuf *p,
                   const ip_addr_t *addr, u16_t port)
