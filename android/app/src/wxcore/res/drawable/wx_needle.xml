<?xml version="1.0" encoding="utf-8"?>
<!-- A compass needle pointing up, to be rotated to wherever the wind is actually going: a filled
     head so the pointing end is unmistakable at eighteen points, and an open tail so it reads as
     a needle rather than as an arrow key. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,2.5 L15.6,12.2 L12,10.6 L8.4,12.2 Z" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M12,13.5 L12,21" />
</vector>
