<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is never needed: Tor/PT traffic is raw sockets, the Settings API is HTTPS.
     Only system CAs are trusted (no user-installed CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
