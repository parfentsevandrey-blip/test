<?xml version="1.0" encoding="utf-8"?>
<!--
  The window, and nothing else. Everything inside it is Compose, which reads the device's own
  Material 3 scheme at runtime; all this has to do is hand the framework a background that matches
  so the first frame is not a flash of the wrong colour.

  Edge to edge is declared here rather than fought for in code: transparent system bars, and no
  scrim drawn behind them.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Quire" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>
