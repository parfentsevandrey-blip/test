    <string name="logs_exposure_desc">Any app on this device can reach these. They are open because tor needs them; the ports are randomised on every start.</string>
    <string name="logs_cooldowns">Endpoints being rested</string>
    <string name="logs_cooldowns_desc">Addresses that accepted a connection and then went silent. Retrying inside the penalty window achieves nothing and can make it longer.</string>
    <string name="action_clear_cooldowns">Retry them anyway</string>
