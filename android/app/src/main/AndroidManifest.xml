<?xml version="1.0" encoding="utf-8"?>
<!--
  What both apps are, and nothing either of them is alone.

  Quire ships as two applications out of one source tree — a calendar and a weather app, each
  installable and updatable without the other. Everything that distinguishes them, including their
  permissions, lives in src/calendar and src/weather; a permission asked for by one must not be
  asked for by the other, which is the main reason this file is nearly empty.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true" />

</manifest>
