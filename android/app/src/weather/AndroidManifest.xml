<?xml version="1.0" encoding="utf-8"?>
<!--
  The weather app. It asks for a coarse location and the network, and for permission to keep its
  hourly job across a reboot; it never touches a calendar.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the hourly refresh survives a reboot rather than waiting for the app to be opened. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only used when rain alerts are switched on, which they are not by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_weather"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_weather_round"
        android:theme="@style/Theme.Quire.Weather">

        <activity
            android:name="app.quire.weather.ui.WeatherActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="quire" android:host="weather" />
            </intent-filter>
        </activity>

        <receiver
            android:name="app.quire.weather.WeatherWidgetProvider"
            android:exported="true"
            android:label="@string/wx_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <receiver
            android:name="app.quire.weather.WeatherTick"
            android:exported="false" />

        <service
            android:name="app.quire.weather.WeatherRefresh"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name="app.quire.weather.WeatherWatch"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
