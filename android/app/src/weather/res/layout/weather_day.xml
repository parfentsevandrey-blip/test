<?xml version="1.0" encoding="utf-8"?>
<!--
  One column of the five-day strip: the day, what it will do, and how far it will swing.

  High and low share a line rather than stacking. A strip is about sixty density-independent
  pixels tall on the card this is designed for, and four stacked things do not fit in sixty —
  which is exactly how the first render came out, with the lows sliced off at the bottom edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/day_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/day_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <!--
      High and low as two views rather than one styled string. A ForegroundColorSpan is a baked
      colour, and a baked colour is the one thing on this card that cannot wear a day face and a
      night face at once — every other colour here is applied with the paired setters the
      launcher resolves against the current theme.
    -->
    <LinearLayout
        android:id="@+id/day_temps_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/day_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/day_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>

    <!--
      The chance of rain. Only ever shown when some day in the strip has one worth writing and
      the strip is tall enough to give it a line; otherwise it is gone and the icon takes the
      room back.
    -->
    <TextView
        android:id="@+id/day_rain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
