<?xml version="1.0" encoding="utf-8"?>
<!--
  One column of the five-day strip: the day, what it will do, and how far it will swing.

  High and low share a line rather than stacking. A strip is about sixty density-independent
  pixels tall on the card this is designed for, and four stacked things do not fit in sixty —
  which is exactly how the first render came out, with the lows sliced off at the bottom edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/day_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/day_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/day_temps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="13sp" />
</LinearLayout>
