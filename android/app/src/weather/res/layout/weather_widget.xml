<?xml version="1.0" encoding="utf-8"?>
<!--
  The weather card. Everything about it is sized at runtime, because a widget is placed at a size
  the app never chose; what is fixed here is the order things appear in and nothing else.

  The five-day strip is empty in the layout and filled by addView, the same way the calendar's
  week rows are: each day is its own RemoteViews, so all five can carry the same ids without
  colliding and each one can be tapped.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface" />

    <ImageView
        android:id="@+id/surface_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface_border" />

    <!--
      The falling layer: rain or snow, behind the type and over the surface, so the card has
      weather in it rather than on it. A ViewFlipper because it is the one view a widget is
      allowed that animates itself — the launcher steps it through its children on its own
      clock, and this process sleeps. Children are added at runtime (WeatherWidgetRenderer):
      six phase frames when something is falling — each drawn in three depths, so the loop
      carries its own parallax — none when the sky is dry, in which case the flipper is GONE
      and costs nothing.
    -->
    <ViewFlipper
        android:id="@+id/sky_motion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="200"
        android:inAnimation="@anim/precip_in"
        android:outAnimation="@anim/precip_out"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/now_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp">

            <!--
              Two ImageViews, one icon: the whole glyph underneath in the accent, and over it
              the same icon's falling part alone — drops, bolt or flakes — in the ink, drawn
              on exactly the same grid so it registers over its own shape. Both go through
              WidgetPaint, so a launcher retheming the card recolours both tones together.
            -->
            <FrameLayout
                android:id="@+id/now_icon_box"
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/now_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/now_icon_detail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/now_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="0dp"
                android:textSize="38sp" />

            <LinearLayout
                android:id="@+id/now_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/now_sky"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/now_feels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingTop="1dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- A white background, so the resource-path tint has a drawable to land on: a bare
             View has nothing to tint and setBackgroundTintList would fall on air. -->
        <FrameLayout
            android:id="@+id/rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#FFFFFFFF" />

        <LinearLayout
            android:id="@+id/strip"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
