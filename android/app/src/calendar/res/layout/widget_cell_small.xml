<?xml version="1.0" encoding="utf-8"?>
<!--
  Same structure as widget_cell, tuned for rows shorter than ~26dp: smaller disc, smaller dots,
  and no chip, because a row that short has no line to give one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/cell_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1.5dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_day_ground"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cell_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/cell_mark"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />

            <TextView
                android:id="@+id/cell_text"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="10sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/cell_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_0"
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
