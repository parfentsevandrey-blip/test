<?xml version="1.0" encoding="utf-8"?>
<!--
  One square of the grid.

  A frame rather than a row, because the cell now has something behind it: a rounded ground that
  the renderer tints by how full the day is, which is the same thing the app does and the reason
  the vertical hairline down every column could go. Seven verticals meeting six horizontals is a
  lattice, and a lattice is a spreadsheet; the tint says "busy" without drawing a single line.

  The ground is an ImageView rather than a background on the body, because a background cannot be
  colour-filtered through RemoteViews and setImageAlpha is the only way to thin one from here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/cell_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2.5dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_day_ground"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cell_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/cell_mark"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />

            <TextView
                android:id="@+id/cell_text"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/cell_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_0"
                android:layout_width="3.5dp"
                android:layout_height="3.5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="3.5dp"
                android:layout_height="3.5dp"
                android:layout_marginStart="2.5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="3.5dp"
                android:layout_height="3.5dp"
                android:layout_marginStart="2.5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/shape_circle" />
        </LinearLayout>

        <!-- Only ever shown where a cell is wide enough to hold a word. -->
        <FrameLayout
            android:id="@+id/cell_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/chip_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chip" />

            <TextView
                android:id="@+id/chip_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1.5dp"
                android:textSize="8sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
