<?xml version="1.0" encoding="utf-8"?>
<!--
  Wound by the launcher every half hour, exactly like the modern card: it is the only wake that
  is exempt from App Standby, and a widget nobody opens is precisely the case that needs it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/retro_widget_description"
    android:initialLayout="@layout/w95_widget"
    android:maxResizeHeight="420dp"
    android:maxResizeWidth="620dp"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="150dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/w95_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
