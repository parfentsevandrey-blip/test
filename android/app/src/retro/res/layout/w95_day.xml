<?xml version="1.0" encoding="utf-8"?>
<!-- One day of the strip: the weekday, a blocky glyph, and the high over the low. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w95_day_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/w95_day_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF000080"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/w95_day_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/w95_day_high"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF000000"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w95_day_low"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF808080"
        android:textSize="11sp" />
</LinearLayout>
