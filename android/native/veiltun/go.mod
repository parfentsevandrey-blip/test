// obfs4 is vendored so its duplicate flag registration can be removed; see
// third_party/obfs4/README.md.
replace github.com/refraction-networking/obfs4 => ./third_party/obfs4

// Conjure's DTLS transport needs a fork of pion/dtls v2, and is reached
// through a registry that cannot be avoided. It is never selected by this app,
// which uses the prefix and min transports; upstream Conjure carries the same
// replace. The pion/dtls v3 used by Snowflake is a different module and
// unaffected.
replace github.com/pion/dtls/v2 => github.com/mingyech/dtls/v2 v2.0.0
