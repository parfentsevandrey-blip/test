<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Veil is distributed outside the App Store: it launches the bundled `tor`
	     process and changes the system proxy, so it runs without the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
