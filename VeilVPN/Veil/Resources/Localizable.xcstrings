          }
        }
      }
    },
    "The exit is not in the country you chose": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گره خروجی در کشوری که انتخاب کردید نیست"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
