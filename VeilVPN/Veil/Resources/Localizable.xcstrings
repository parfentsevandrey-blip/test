      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Построение цепочек"
          }
        }
      }
    },
    "Built-in obfs4 bridges from Tor Browser. Fast, but the addresses are public and may already be blocked.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные мосты obfs4 из Tor Browser. Быстро, но адреса публичны и могут быть уже заблокированы."
          }
        }
      }
