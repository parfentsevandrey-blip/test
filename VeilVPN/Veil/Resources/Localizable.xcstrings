          }
        }
      }
    },
    "Reconnecting automatically…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال مجدد خودکار…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
