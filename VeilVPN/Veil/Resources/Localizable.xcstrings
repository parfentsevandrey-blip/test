    "Bridges, routes, sites, padding and every other preference in one JSON file.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پل‌ها، مسیرها، سایت‌ها، پوشش ترافیک و همهٔ تنظیمات دیگر در یک فایل JSON."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мосты, маршруты, сайты, маскировка и все остальные настройки в одном JSON-файле."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
