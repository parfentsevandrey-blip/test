    },
    "Network checks need a live connection; they will be skipped.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی‌های شبکه به اتصال فعال نیاز دارند و رد خواهند شد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевые проверки требуют активного подключения — они будут пропущены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережеві перевірки потребують активного підключення — їх буде пропущено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络检查需要活动连接，将被跳过。"
          }
        }
      }
    },
    "Network not responding — resetting %@, like Wi-Fi off and on…": {
      "localizations": {
