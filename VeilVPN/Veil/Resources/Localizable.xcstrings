    "The bridge service answered with HTTP %lld.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба мостов ответила HTTP %lld."
          }
        }
      }
    },
    "The bridge service has no bridges for this location.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У службы мостов нет мостов для этого региона."
          }
        }
      }
    },
    "The desktop app uses the system proxy for HTTPS; calls use UDP.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настольное приложение использует системный прокси для HTTPS; звонки идут по UDP."
          }
        }
      }
    },
    "The kill switch keeps proxied apps blocked whenever Tor is down, and Veil reconnects automatically when the network comes back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill switch блокирует приложения с прокси, пока Tor не работает, а Veil переподключается автоматически, когда сеть возвращается."
          }
        }
      }
    },
    "The padding loop was closed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл маскировки был закрыт."
          }
