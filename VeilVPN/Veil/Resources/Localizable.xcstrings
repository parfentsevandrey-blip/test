          }
        }
      }
    },
    "Route system traffic through Tor automatically": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически направлять системный трафик через Tor"
          }
        }
      }
    },
    "Routed through Tor": {
      "localizations": {
