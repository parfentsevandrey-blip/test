      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor не успел подключиться. Возможно, сейчас мало Snowflake-прокси — попробуйте ещё раз или смените мосты."
          }
        }
      }
    },
    "Tor did not create the private onion service needed for traffic padding.": {
      "localizations": {
