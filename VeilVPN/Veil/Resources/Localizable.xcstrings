    "Administrator authorization was not granted.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Права администратора не были предоставлены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Права адміністратора не надано."
          }
        }
