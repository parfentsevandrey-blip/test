          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor 在待机状态下停止了。"
          }
        }
      }
    },
    "Tor · Snowflake": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor · Snowflake"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor · Snowflake"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor · Snowflake"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor · Snowflake"
          }
        }
      }
    },
    "Tor’s caches stay on disk after you quit": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظهٔ نهان Tor پس از خروج روی دیسک می‌ماند"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш Tor остаётся на диске после выхода"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеш Tor лишається на диску після виходу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后 Tor 的缓存仍留在磁盘上"
          }
        }
      }
    },
    "Tor’s entry guard stays on disk": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نگهبان ورودی Tor روی دیسک می‌ماند"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входной страж Tor остаётся на диске"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхідний страж Tor лишається на диску"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor 的入口守卫仍留在磁盘上"
          }
        }
      }
    },
    "Total %@ down · %@ up": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموع %@ دریافت · %@ ارسال"
          }
        },
        "ru": {
