    "Send everything through Tor": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرستادن همه‌چیز از طریق Tor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направить всё через Tor"
          }
        },
        "uk": {
          "stringUnit": {
