    "Tunnels through a large CDN with domain fronting. Slow but very hard to block; the built-in bridge comes from Tor Browser.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از طریق یک CDN بزرگ با domain fronting تونل می‌زند. کند اما بسیار سخت‌مسدودشونده؛ پل داخلی از Tor Browser است."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туннель через крупный CDN с domain fronting. Медленно, но очень трудно заблокировать; встроенный мост взят из Tor Browser."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тунель через великий CDN із domain fronting. Повільно, але дуже важко заблокувати; вбудований міст узято з Tor Browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过域前置经由大型 CDN 建立隧道。速度慢但极难封锁；内置网桥来自 Tor Browser。"
          }
        }
      }
    },
