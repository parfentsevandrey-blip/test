            "state": "translated",
            "value": "桌面应用的 HTTPS 使用系统代理；通话使用 UDP。"
          }
        }
      }
    },
    "The exit check says this is not Tor": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی گره خروجی می‌گوید این Tor نیست"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
