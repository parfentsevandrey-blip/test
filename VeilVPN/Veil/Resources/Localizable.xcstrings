    "Import…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درون‌ریزی…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт…"
          }
        },
        "uk": {
