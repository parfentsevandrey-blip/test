    "Reaches Tor through volunteer proxies, even where Tor is blocked.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از طریق پراکسی‌های داوطلبان به Tor می‌رسد، حتی جایی که Tor مسدود است."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Tor через прокси волонтёров — даже там, где Tor заблокирован."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до Tor через проксі волонтерів — навіть там, де Tor заблоковано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过志愿者代理连接 Tor，即使在 Tor 被封锁的地方也能用。"
          }
        }
      }
    },
    "Reaching a Snowflake proxy": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال یافتن پراکسی Snowflake"
