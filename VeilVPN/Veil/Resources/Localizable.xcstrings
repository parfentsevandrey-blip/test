            "state": "translated",
            "value": "正在寻找 Snowflake 代理"
          }
        }
      }
    },
    "Received %lld %@ bridge(s); transport set to custom": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld پل %@ دریافت شد؛ روش انتقال روی «سفارشی» تنظیم شد"
