{
  "sourceLanguage": "en",
  "strings": {
    "%@ did not respond, trying %@…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پاسخ نداد، در حال امتحان %@…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не ответил, пробую %@…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не відповів, пробую %@…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无响应，正在尝试 %@…"
          }
        }
      }
    },
    "%@ has not reached a relay yet — %@.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ هنوز به هیچ بازپخشی نرسیده است — %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ещё не дошёл до узла — %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще не дійшов до вузла — %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未连接到任何中继 — %@。"
          }
        }
      }
    },
    "%lld destination group(s) bypass Tor and see your real IP.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld گروه مقصد از Tor عبور نمی‌کنند و نشانی IP واقعی شما را می‌بینند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Групп назначений в обход Tor: %lld — они видят ваш настоящий IP."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Груп призначень в обхід Tor: %lld — вони бачать вашу справжню IP-адресу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 组目标绕过 Tor，它们能看到你的真实 IP。"
          }
        }
      }
    },
    "%lld hops · click for a new identity": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld گره · برای هویت جدید کلیک کنید"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld узлов · клик — новая личность"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld вузлів · клік — нова особа"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 跳 · 点击更换身份"
          }
        }
      }
    },
    "%lld of %lld Tor directory authorities reachable": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld از %lld مرجع دایرکتوری Tor در دسترس است"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно управляющих серверов Tor: %lld из %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно керівних серверів Tor: %lld із %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个 Tor 目录管理服务器可达（共 %lld 个）"
          }
        }
      }
    },
    "%lld% of traffic": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld٪ از ترافیک"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld% трафика"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld% трафіку"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占流量 %lld%"
          }
        }
      }
    },
    "A Liquid Glass client for the Tor network with Snowflake bridges. Tor, Snowflake and Lyrebird are © The Tor Project, Inc. and distributed under their own licenses.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلاینت شبکهٔ Tor با پل‌های Snowflake و طراحی Liquid Glass. حقوق Tor، Snowflake و Lyrebird متعلق به The Tor Project, Inc. است و با مجوزهای خودشان منتشر می‌شوند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиент сети Tor с мостами Snowflake в стиле Liquid Glass. Tor, Snowflake и Lyrebird — © The Tor Project, Inc., распространяются по собственным лицензиям."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клієнт мережі Tor з мостами Snowflake у стилі Liquid Glass. Tor, Snowflake і Lyrebird — © The Tor Project, Inc., поширюються за власними ліцензіями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用 Liquid Glass 设计、内置 Snowflake 网桥的 Tor 网络客户端。Tor、Snowflake 与 Lyrebird 版权归 The Tor Project, Inc. 所有，并按各自许可证分发。"
          }
        }
      }
    },
    "A circuit per site": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک مدار برای هر سایت"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельная цепочка для каждого сайта"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрема ланцюжок для кожного сайту"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个站点一条链路"
          }
        }
      }
    },
    "A direct Tor connection is easy to identify. A bridge makes it look like ordinary traffic.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال مستقیم به Tor به‌سادگی شناسایی می‌شود. یک پل آن را شبیه ترافیک عادی می‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямое подключение к Tor легко распознать. Мост делает трафик похожим на обычный."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пряме підключення до Tor легко розпізнати. Міст робить трафік схожим на звичайний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连 Tor 很容易被识别。网桥会让流量看起来像普通流量。"
          }
        }
      }
    },
    "A direct Tor connection is recognisable": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال مستقیم به Tor قابل تشخیص است"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямое подключение к Tor распознаётся"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пряме підключення до Tor розпізнається"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连 Tor 可被识别"
          }
        }
      }
    },
    "A name is handed to Tor rather than looked up on this Mac, so nothing leaks to your DNS server.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام میزبان به Tor سپرده می‌شود و روی این مک جست‌وجو نمی‌شود، بنابراین چیزی به سرور DNS شما درز نمی‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя передаётся в Tor, а не разрешается на этом Mac, поэтому ваш DNS-сервер ничего не узнаёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ім’я передається в Tor, а не розв’язується на цьому Mac, тому ваш DNS-сервер нічого не дізнається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机名交给 Tor 解析，而不是在这台 Mac 上查询，因此不会泄露给你的 DNS 服务器。"
          }
        }
      }
    },
    "A timed rotation steers away from the relays it just used, so the route really moves. Existing connections keep theirs until they finish.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چرخش زمان‌بندی‌شده از بازپخش‌هایی که همین حالا استفاده شده‌اند فاصله می‌گیرد تا مسیر واقعاً جابه‌جا شود. اتصال‌های باز تا پایان روی مدار خود می‌مانند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ротация по таймеру уводит маршрут от только что использованных узлов, чтобы он действительно сменился. Уже открытые соединения остаются на своих цепочках до завершения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ротація за таймером відводить маршрут від щойно використаних вузлів, щоб він справді змінився. Уже відкриті з’єднання лишаються на своїх ланцюжках до завершення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时轮换会避开刚刚用过的中继，让线路真正改变。已打开的连接会保留原有链路直到结束。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درباره"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про програму"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فعالیت"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активность"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активність"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动"
          }
        }
      }
    },
    "Add Veil’s proxy to Telegram": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن پراکسی Veil به Telegram"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить прокси Veil в Telegram"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати проксі Veil у Telegram"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Veil 的代理添加到 Telegram"
          }
        }
      }
    },
    "Add proxy": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "افزودن پراکسی"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить прокси"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати проксі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加代理"
          }
        }
      }
    },
    "Adds cover traffic through a private onion loop so the shape of your browsing is harder to read.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از طریق یک حلقهٔ onion خصوصی ترافیک پوششی اضافه می‌کند تا الگوی مرور شما سخت‌تر خوانده شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет маскирующий трафик через собственную onion-петлю, чтобы форму вашего трафика было труднее прочитать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає маскувальний трафік через власну onion-петлю, щоб форму вашого трафіку було важче прочитати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过私有 onion 回环添加掩护流量，让你的浏览特征更难被读出。"
          }
        }
      }
    },
    "Administrator authorization was not granted.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مجوز مدیر داده نشد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Права администратора не были предоставлены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Права адміністратора не надано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予管理员权限。"
          }
        }
      }
    },
    "After connecting and after every route change Veil builds a few extra circuits, times them and pins the exit relays (and the middle relay, when you chose its country) of the quickest ones. Two exits are kept so one going away does not stall you; everything is measured again every half hour.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از اتصال و پس از هر تغییر مسیر، Veil چند مدار اضافی می‌سازد، زمان آن‌ها را می‌سنجد و رله‌های خروجی (و رلهٔ میانی، اگر کشورش را انتخاب کرده باشید) سریع‌ترین‌ها را سنجاق می‌کند. دو خروجی نگه داشته می‌شود تا رفتن یکی شما را متوقف نکند؛ هر نیم ساعت همه‌چیز دوباره اندازه‌گیری می‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После подключения и после каждой смены маршрута Veil строит несколько дополнительных цепочек, измеряет их время и закрепляет выходные узлы (и промежуточный, если вы выбрали его страну) самых быстрых. Сохраняются два выходных узла, чтобы уход одного не остановил вас; всё измеряется заново каждые полчаса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після підключення та після кожної зміни маршруту Veil будує кілька додаткових ланцюжків, вимірює їхній час і закріплює вихідні вузли (та проміжний, якщо ви обрали його країну) найшвидших. Зберігаються два вихідні вузли, щоб зникнення одного не зупинило вас; усе вимірюється знову кожні пів години."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后以及每次更改路由后，Veil 会额外构建几条链路并计时，然后固定最快链路的出口中继（以及您选择了国家的中间中继）。保留两个出口，一个失效时不会卡住；每半小时重新测量一次。"
          }
        }
      }
    },
    "After sleep, or after another VPN disconnects, macOS often reports a working network while nothing gets through until Wi-Fi is switched off and on. Veil checks the Internet before starting Tor and after every wake, and does that switch for you — CoreWLAN first, then the network service — before trying Tor again.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از خواب یا قطع شدن VPN دیگری، macOS اغلب شبکه را سالم نشان می‌دهد در حالی که تا خاموش و روشن کردن Wi-Fi چیزی عبور نمی‌کند. Veil پیش از شروع Tor و پس از هر بیداری اینترنت را بررسی می‌کند و این کار را برایتان انجام می‌دهد — ابتدا CoreWLAN، سپس سرویس شبکه — پیش از آنکه دوباره Tor را امتحان کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сна или отключения другого VPN macOS часто показывает рабочую сеть, хотя ничего не проходит, пока не выключить и включить Wi-Fi. Veil проверяет интернет перед запуском Tor и после каждого пробуждения и делает это переключение за вас — сначала CoreWLAN, затем сетевую службу — прежде чем снова пробовать Tor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після сну або відключення іншого VPN macOS часто показує робочу мережу, хоча нічого не проходить, доки не вимкнути й увімкнути Wi-Fi. Veil перевіряє інтернет перед запуском Tor і після кожного пробудження та робить це перемикання за вас — спочатку CoreWLAN, потім мережеву службу — перш ніж знову пробувати Tor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠后或其他 VPN 断开后，macOS 常常显示网络正常，但在关闭再打开 Wi-Fi 之前什么都不通。Veil 会在启动 Tor 前和每次唤醒后检查互联网，并替您完成这一切换——先 CoreWLAN，再网络服务——然后再重试 Tor。"
          }
        }
      }
    },
    "An exit relay can read and change anything that is not encrypted.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازپخش خروجی می‌تواند هر چیزی را که رمزگذاری نشده بخواند و تغییر دهد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходной узел может прочитать и изменить всё, что не зашифровано."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихідний вузол може прочитати й змінити все, що не зашифроване."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口中继可以读取并篡改任何未加密的内容。"
          }
        }
      }
    },
    "An exit relay can read and rewrite anything that is not encrypted.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازپخش خروجی می‌تواند هر چیزی را که رمزگذاری نشده بخواند و بازنویسی کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходной узел может прочитать и подменить всё, что не зашифровано."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихідний вузол може прочитати й підмінити все, що не зашифроване."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口中继可以读取并重写任何未加密的内容。"
          }
        }
      }
    },
    "Another Tor is using Veil’s data directory. %@": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک Tor دیگر از پوشهٔ دادهٔ Veil استفاده می‌کند. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог данных Veil занят другим процессом Tor. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог даних Veil зайнятий іншим процесом Tor. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 Tor 进程正在使用 Veil 的数据目录。%@"
          }
        }
      }
    },
    "Another VPN owns the connection (%@); not touching it.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال در اختیار VPN دیگری است (%@)؛ به آن دست نمی‌زنم."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединением владеет другой VPN (%@); не трогаю его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднанням володіє інший VPN (%@); не чіпаю його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接由另一个 VPN 接管（%@）；不作更改。"
          }
        }
      }
    },
    "Another user on this Mac could replace the pluggable transport binaries.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کاربر دیگری روی این مک می‌تواند فایل‌های اجرایی ترابری‌های افزودنی را جایگزین کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой пользователь этого Mac может подменить исполняемые файлы подключаемых транспортов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший користувач цього Mac може підмінити виконувані файли підключних транспортів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的其他用户可以替换可插拔传输的可执行文件。"
          }
        }
      }
    },
    "Anti-throttling": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ضد کندسازی"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обход замедления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обхід сповільнення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反限速"
          }
        }
      }
    },
    "Anti-throttling technique": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روش ضد کندسازی"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Техника обхода замедления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Техніка обходу сповільнення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反限速技术"
          }
        }
      }
    },
    "Anyone with this Mac can read which bridges you use, which may identify you.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کسی که به این مک دسترسی داشته باشد می‌تواند ببیند از کدام پل‌ها استفاده می‌کنید و این ممکن است شما را شناسایی کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, у кого есть доступ к этому Mac, увидит, какими мостами вы пользуетесь — это может вас идентифицировать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-хто з доступом до цього Mac побачить, якими мостами ви користуєтесь — це може вас ідентифікувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何能接触这台 Mac 的人都能看到你使用哪些网桥，这可能会暴露你的身份。"
          }
        }
      }
    },
    "Anything on the clipboard can be read by other apps.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر چیزی که در کلیپ‌بورد باشد را برنامه‌های دیگر می‌توانند بخوانند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что лежит в буфере обмена, доступно другим приложениям."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що лежить у буфері обміну, доступне іншим застосункам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板中的内容可被其他应用读取。"
          }
        }
      }
    },
    "App Store & iCloud": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store و iCloud"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store и iCloud"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store та iCloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 与 iCloud"
          }
        }
      }
    },
    "App Store downloads, updates and iCloud stall or fail through Tor exits, so they go direct by default. Switch to Tor if you prefer.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دانلودهای App Store، به‌روزرسانی‌ها و iCloud از طریق خروجی‌های Tor متوقف یا ناموفق می‌شوند، بنابراین به طور پیش‌فرض مستقیم می‌روند. در صورت تمایل به Tor تغییر دهید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки из App Store, обновления и iCloud через выходы Tor зависают или не работают, поэтому по умолчанию идут напрямую. При желании переключите на Tor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження з App Store, оновлення та iCloud через виходи Tor зависають або не працюють, тому типово йдуть напряму. За бажанням перемкніть на Tor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 下载、更新和 iCloud 经 Tor 出口会卡住或失败，因此默认直连。如需可切换为 Tor。"
          }
        }
      }
    },
    "Application": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Applies to browser traffic immediately; apps using Veil’s SOCKS port directly pick it up on their next connection.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ترافیک مرورگر بی‌درنگ اعمال می‌شود؛ برنامه‌هایی که مستقیماً به درگاه SOCKS وصل‌اند در اتصال بعدی آن را می‌گیرند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К трафику браузера применяется сразу; приложения, подключённые к SOCKS-порту Veil напрямую, подхватят это при следующем соединении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До трафіку браузера застосовується одразу; застосунки, підключені до SOCKS-порту Veil напряму, підхоплять це під час наступного з’єднання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对浏览器流量立即生效；直接使用 Veil SOCKS 端口的应用会在下次连接时生效。"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ها"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Apps are not pointed at Veil, so nothing is tunnelled unless you configure each one by hand.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ها به Veil اشاره نمی‌کنند، بنابراین تا زمانی که هرکدام را دستی تنظیم نکنید چیزی تونل نمی‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения не направлены на Veil, поэтому ничего не туннелируется, пока вы не настроите каждое вручную."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки не спрямовані на Veil, тому нічого не тунелюється, доки ви не налаштуєте кожен вручну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用没有指向 Veil，除非你逐个手动配置，否则不会走隧道。"
          }
        }
      }
    },
    "Apps that ignore the system proxy — many Electron apps, most installers, Telegram’s desktop app — connect directly. Veil cannot stop them.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌هایی که پراکسی سیستمی را نادیده می‌گیرند — بسیاری از برنامه‌های Electron، بیشتر نصب‌کننده‌ها و برنامهٔ دسکتاپ تلگرام — مستقیم وصل می‌شوند. Veil نمی‌تواند جلوی آن‌ها را بگیرد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения, игнорирующие системный прокси — многие Electron-приложения, большинство установщиков, десктопный Telegram — подключаются напрямую. Veil не может им помешать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки, що ігнорують системний проксі — багато Electron-застосунків, більшість інсталяторів, десктопний Telegram — з’єднуються напряму. Veil не може їм завадити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略系统代理的应用——许多 Electron 应用、大多数安装程序、Telegram 桌面版——会直接连接。Veil 无法阻止它们。"
          }
        }
      }
    },
    "Arms the system proxy before Tor is up and keeps it pointed at Veil if Tor dies, so apps that use the proxy are blocked instead of leaking. Apps that ignore the proxy are not covered without a system extension.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پراکسی سیستم را پیش از بالا آمدن Tor فعال می‌کند و اگر Tor از کار بیفتد آن را روی Veil نگه می‌دارد تا برنامه‌هایی که از پراکسی استفاده می‌کنند مسدود شوند نه اینکه نشت کنند. برنامه‌هایی که پراکسی را نادیده می‌گیرند بدون افزونهٔ سیستمی پوشش داده نمی‌شوند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает системный прокси ещё до запуска Tor и оставляет его направленным на Veil, если Tor упадёт: приложения с прокси блокируются, а не утекают. Приложения, игнорирующие прокси, без системного расширения не защищены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає системний проксі ще до запуску Tor і лишає його спрямованим на Veil, якщо Tor упаде: програми з проксі блокуються, а не витікають. Програми, що ігнорують проксі, без системного розширення не захищені."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Tor 启动前就设置系统代理，并在 Tor 崩溃时保持代理指向 Veil，这样使用代理的应用会被阻断而不是泄漏。忽略代理的应用在没有系统扩展的情况下不受保护。"
          }
        }
      }
    },
    "Asks bridges.torproject.org (directly, then through a domain-fronted CDN) for bridges recommended for your country and switches to them.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از bridges.torproject.org (ابتدا مستقیم، سپس از طریق CDN با domain fronting) پل‌های پیشنهادی برای کشور شما را می‌گیرد و به آن‌ها سوئیچ می‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает у bridges.torproject.org (напрямую, затем через CDN с domain fronting) мосты, рекомендованные для вашей страны, и переключается на них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує в bridges.torproject.org (напряму, потім через CDN із domain fronting) мости, рекомендовані для вашої країни, і перемикається на них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 bridges.torproject.org 请求（先直连，再通过域前置 CDN）为你所在国家/地区推荐的网桥，并切换到这些网桥。"
          }
        }
      }
    },
    "Authorization was cancelled.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مجوزدهی لغو شد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторизация отменена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторизацію скасовано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权已取消。"
          }
        }
      }
    },
