    "YouTube Turbo is active, Tor is off": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube Turbo فعال است، Tor خاموش است"
          }
        },
        "ru": {
          "stringUnit": {
