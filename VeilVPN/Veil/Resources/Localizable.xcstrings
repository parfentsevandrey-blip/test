    "Updates are downloaded from the GitHub releases of this project; replace Veil in Applications and relaunch.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی‌ها از انتشارهای GitHub این پروژه دانلود می‌شوند؛ Veil را در Applications جایگزین و دوباره اجرا کنید."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления скачиваются из релизов проекта на GitHub; замените Veil в «Программах» и перезапустите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення завантажуються з релізів проєкту на GitHub; замініть Veil у «Програмах» і перезапустіть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
