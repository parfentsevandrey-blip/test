    },
    "Bridges": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мосты"
          }
        }
      }
    },
    "Bridges, routes, sites, padding and every other preference in one JSON file.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мосты, маршруты, сайты, маскировка и все остальные настройки в одном JSON-файле."
          }
        }
      }
    },
    "Building a circuit…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Построение цепочки…"
          }
