    },
    "No bridge lines configured. Paste bridges in Settings → Bridges or choose another transport.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не указаны строки мостов. Вставьте мосты в Настройки → Мосты или выберите другой транспорт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вказано рядків мостів. Вставте мости в Налаштування → Мости або виберіть інший транспорт."
          }
        }
      }
    },
    "No free local ports available.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет свободных локальных портов."
          }
