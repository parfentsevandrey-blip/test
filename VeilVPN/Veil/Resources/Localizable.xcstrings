          "stringUnit": {
            "state": "translated",
            "value": "触控板触感反馈"
          }
        }
      }
    },
    "Hides the fact that you are using Tor from the network you are on.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این واقعیت را که از Tor استفاده می‌کنید از شبکهٔ شما پنهان می‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает от вашей сети сам факт использования Tor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховує від вашої мережі сам факт використання Tor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向所在网络隐藏您正在使用 Tor 的事实。"
          }
        }
      }
    },
    "Home": {
      "localizations": {
