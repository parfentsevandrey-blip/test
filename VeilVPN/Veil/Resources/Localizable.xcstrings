      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напрямую"
          }
        }
      }
    },
    "Direct (no bridges)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напрямую (без мостов)"
          }
        }
