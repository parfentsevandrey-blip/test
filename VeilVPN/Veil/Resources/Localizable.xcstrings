          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тактильный отклик на трекпаде"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тактильний відгук на трекпаді"
          }
        },
