    },
    "Anti-throttling": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обход замедления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обхід сповільнення"
          }
        }
      }
    },
    "Anti-throttling technique": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Техника обхода замедления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Техніка обходу сповільнення"
          }
        }
      }
    },
    "Application": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма"
          }
        }
      }
    },
    "Arms the system proxy before Tor is up and keeps it pointed at Veil if Tor dies, so apps that use the proxy are blocked instead of leaking. Apps that ignore the proxy are not covered without a system extension.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает системный прокси ещё до запуска Tor и оставляет его направленным на Veil, если Tor упадёт: приложения с прокси блокируются, а не утекают. Приложения, игнорирующие прокси, без системного расширения не защищены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає системний проксі ще до запуску Tor і лишає його спрямованим на Veil, якщо Tor упаде: програми з проксі блокуються, а не витікають. Програми, що ігнорують проксі, без системного розширення не захищені."
          }
        }
      }
    },
    "Asks bridges.torproject.org (directly, then through a domain-fronted CDN) for bridges recommended for your country and switches to them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает у bridges.torproject.org (напрямую, затем через CDN с domain fronting) мосты, рекомендованные для вашей страны, и переключается на них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує в bridges.torproject.org (напряму, потім через CDN із domain fronting) мости, рекомендовані для вашої країни, і перемикається на них."
          }
        }
      }
    },
    "Authorization was cancelled.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторизация отменена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Авторизацію скасовано."
          }
        }
      }
    },
