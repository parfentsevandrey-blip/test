          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何连接 Tor 网络"
          }
        }
      }
    },
    "If Tor dies, proxied apps fall back to connecting directly.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر Tor از کار بیفتد، برنامه‌های پراکسی‌شده مستقیم وصل می‌شوند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Tor упадёт, приложения через прокси начнут подключаться напрямую."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо Tor впаде, застосунки через проксі почнуть з’єднуватися напряму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Tor 停止运行，走代理的应用会退回直连。"
          }
        }
      }
    },
    "Ignores the system proxy": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پراکسی سیستم را نادیده می‌گیرد"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игнорирует системный прокси"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ігнорує системний проксі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略系统代理"
          }
        }
      }
    },
    "Import Veil settings": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درون‌ریزی تنظیمات Veil"
          }
        },
        "ru": {
          "stringUnit": {
