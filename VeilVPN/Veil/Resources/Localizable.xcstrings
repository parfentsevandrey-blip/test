        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tor · Snowflake"
          }
        }
      }
    },
    "Traffic is encrypted and relayed through three Tor relays.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трафик шифруется и проходит через три узла Tor."
          }
        }
      }
