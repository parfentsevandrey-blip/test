    "Snowflake bridge": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мост Snowflake"
          }
        }
      }
    },
    "Snowflake first has to find a volunteer proxy; in censored networks this can take 10–60 seconds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowflake сначала ищет прокси волонтёра; в сетях с цензурой это занимает 10–60 секунд."
          }
        }
      }
