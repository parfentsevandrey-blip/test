    "Direct modes are fast, but the site sees your real IP address. Everything else still goes through Tor.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حالت‌های مستقیم سریع‌اند، اما سایت آدرس IP واقعی شما را می‌بیند. بقیهٔ ترافیک همچنان از Tor عبور می‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямые режимы быстрые, но сайт видит ваш реальный IP-адрес. Всё остальное по-прежнему идёт через Tor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямі режими швидкі, але сайт бачить вашу справжню IP-адресу. Усе інше й далі йде через Tor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连模式速度快，但站点会看到你的真实 IP 地址。其他一切仍通过 Tor。"
          }
        }
      }
    },
    "Direct, anti-throttling": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مستقیم، با ضد کندسازی"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напрямую, с обходом замедления"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напряму, з обходом сповільнення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
