    "Race circuits and pin the fastest relays": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسابقهٔ مدارها و سنجاق کردن سریع‌ترین رله‌ها"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устраивать гонку цепочек и закреплять самые быстрые узлы"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Влаштовувати перегони ланцюжків і закріплювати найшвидші вузли"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链路竞速并固定最快中继"
          }
        }
      }
    },
    "Racing %lld circuits, %lld built…": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسابقهٔ %lld مدار، %lld ساخته شد…"
          }
        },
        "ru": {
          "stringUnit": {
