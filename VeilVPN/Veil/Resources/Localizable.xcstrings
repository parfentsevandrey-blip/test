    "Web and the desktop app follow the system proxy; voice (UDP) never goes through a proxy.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ وب و برنامهٔ دسکتاپ از پراکسی سیستم پیروی می‌کنند؛ صدا (UDP) هرگز از پراکسی عبور نمی‌کند."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-версия и настольное приложение следуют системному прокси; голос (UDP) через прокси не идёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вебверсія та настільна програма дотримуються системного проксі; голос (UDP) через проксі не йде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页版和桌面应用遵循系统代理；语音（UDP）不会经过代理。"
          }
        }
      }
    },
    "Welcome to Veil": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به Veil خوش آمدید"
