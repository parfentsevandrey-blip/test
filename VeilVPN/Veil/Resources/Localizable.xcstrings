    "How to reach the Tor network": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چگونه به شبکهٔ Tor برسیم"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как подключаться к сети Tor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
