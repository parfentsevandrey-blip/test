    },
    "Open Veil to download the update.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دانلود به‌روزرسانی، Veil را باز کنید."
          }
        },
        "ru": {
          "stringUnit": {
