            "value": "Спрямувати все через Tor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所有流量都经过 Tor"
          }
        }
      }
    },
    "Separate Tor circuit for every site": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدار Tor جداگانه برای هر سایت"
          }
        },
