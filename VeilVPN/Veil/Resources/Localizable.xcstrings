    "Could not connect": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться"
          }
        }
      }
    },
    "Could not reach Veil’s private onion service through Tor.": {
      "localizations": {
