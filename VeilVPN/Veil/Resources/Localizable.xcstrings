    "Avoid Five Eyes countries (US, UK, Canada, Australia, New Zealand)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегать стран «Пяти глаз» (США, Великобритания, Канада, Австралия, Новая Зеландия)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уникати країн «П’яти очей» (США, Велика Британія, Канада, Австралія, Нова Зеландія)"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        }
