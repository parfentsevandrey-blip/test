          }
        }
      }
    },
    "Direct, so updates keep working": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مستقیم، تا به‌روزرسانی‌ها کار کنند"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
