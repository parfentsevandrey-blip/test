# Скопируйте в .env и подставьте свои ключи. Файл .env в .gitignore.
#
# Ключи создаются в Gate.io: Профиль -> API Keys -> Create API Key.
# Права: "Spot Trade" (чтение + торговля). НЕ включайте вывод средств (Withdraw).
# Обязательно ограничьте ключ по IP-адресу сервера.

GATEIO_API_KEY=
GATEIO_API_SECRET=
