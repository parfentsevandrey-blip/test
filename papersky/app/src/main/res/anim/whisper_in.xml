<?xml version="1.0" encoding="utf-8"?>
<!-- Enters only after the previous line has gone, so two lines never overlap. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="560"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:startOffset="280">
    <translate
        android:fromYDelta="35%"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
