<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-weight instance of a variable font, used by RemoteViews layouts (widgets), which
     cannot set variation settings at runtime. Cormorant Garamond Italic: the human voice (notes). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/serif_italic"
        android:fontStyle="italic"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
</font-family>
