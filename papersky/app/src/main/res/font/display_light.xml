<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-weight instance of a variable font, used by RemoteViews layouts (widgets), which
     cannot set variation settings at runtime. Cormorant Garamond Light: the big temperature and clock. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/serif"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 300"
        android:fontWeight="300" />
</font-family>
