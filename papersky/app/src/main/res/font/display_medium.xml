<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-weight instance of Manrope for RemoteViews layouts (widgets), which cannot set
     variation settings at runtime. The whole product uses this one family. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/manrope"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600" />
</font-family>
