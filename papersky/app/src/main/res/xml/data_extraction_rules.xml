<?xml version="1.0" encoding="utf-8"?>
<!-- Only places and settings travel with backups; cached forecasts are simply re-downloaded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
